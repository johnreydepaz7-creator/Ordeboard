PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/orderboard
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Gmail account used to SEND password reset emails (not individual staff Gmail login).
# Use a Google App Password, never the Gmail account's normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# The address users will open to reset their password. Include the correct
# server hostname / LAN IP; the URL must be reachable on their device.
RESET_LINK_BASE_URL=http://localhost:5173/
# Optional; defaults to Gmail's encrypted SMTP service:
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465

# Render automatically uses Resend for password resets and email changes.
# Set these in the Render dashboard to enable account email.
RESEND_API_KEY=
RESEND_FROM=

# Offline recovery (optional until configured; highly recommended).
# Run: npm.cmd run recovery-key --prefix server
# Store the printed plaintext key OFFLINE; paste ONLY its SHA-256 HASH below.
OWNER_RECOVERY_KEY_HASH=
